{
  "expo": {
    "sdkVersion": "57.0.0",
    "name": "SheCare",
    "slug": "shecare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "shecare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shecare.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SheCare uses the microphone for voice journal entries.",
        "NSPhotoLibraryUsageDescription": "SheCare accesses your photos for profile avatars.",
        "NSCameraUsageDescription": "SheCare needs camera access to add photos and videos to your memory diary.",
        "NSPhotoLibraryAddUsageDescription": "SheCare saves edited photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E63462"
      },
      "package": "com.shecare.app",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-dev-client",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesHermes": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "SheCare needs access to your photos for memory diary images.",
          "cameraPermission": "SheCare needs camera access to capture photos and videos for your memory diary."
        }
      ]
    ],
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "8b099bcb-5141-4d25-8e95-13fe2fc47ce6"
      }
    }
  }
}
